rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each browser's anonymous user can only see and change its own parkings.
    match /users/{uid}/parkings/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Survey photos: only approved surveyors (anonymous IDs shown on the Survey screen) can add or read them.
    // Records can't be changed or deleted from the app, and each must stay small.
    function surveyor() {
      return request.auth != null && request.auth.uid in [
        "hTZ0qnWZqcWcwkXlJNSee141hWp1", // laptop (Chrome)
        "gVBinpEKc4bSca91T2sSDvTPou82", // learner's phone
        "SuNCy5uU0YTZHnEainnWe4hXPI42", // learner's second device/browser
      ];
    }
    // Buildings anyone can add (Wayback for any building): readable by any signed-in user,
    // changeable only by the person who added them.
    match /buildings/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /floors/{floorId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/buildings/$(id)).data.owner == request.auth.uid;
      }
    }

    // Room numbers checked at the door: every signed-in phone reads them for directions; only
    // surveyors can set them, one per room spot (e.g. room-f5-03), and only in the F5-03 form.
    match /roomNumbers/{roomId} {
      allow read: if request.auth != null;
      allow create, update: if surveyor()
        && roomId.matches('^room-f[0-9]{1,2}-[0-9]{2}$')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.number is string
        && request.resource.data.number.matches('^F[0-9]{1,2}-[0-9]{2}$');
    }

    match /survey/{id} {
      allow read: if surveyor();
      allow create: if surveyor()
        && request.resource.data.by == request.auth.uid
        && (request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 600000))
        && request.resource.data.note is string
        && request.resource.data.note.size() < 2000;
    }
  }
}
